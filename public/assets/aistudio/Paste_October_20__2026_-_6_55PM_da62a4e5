    {
        "id": "0991aa4e4bebefd2",
        "type": "function",
        "z": "a4fa68e69bdc0ac7",
        "name": "Logica: DC",
        "func": "// ==========================================================================\n// LOGICA INTEGRALE ENERGIA DC ( Wh ) - REVISIONATO E ROBUSTO\n// ==========================================================================\n\nlet now = Date.now();\nlet dc_wh = global.get('dc_wh') || 0;\n\n// Recuperiamo ultimo timestamp e ultima potenza dallo scope globale (sincronizzato con reset mezzanotte)\nlet lastT = global.get('log_dc_last_t') || now;\nlet lastWatts = global.get('log_dc_last_watts') || 0;\n\nlet newWatts = Math.abs(parseFloat(msg.payload)) || 0;\n\n// Tempo trascorso dall'ultima lettura (in ore)\nlet tDiffHours = (now - lastT) / 3600000;\n\n// 1. INTEGRALE MATEMATICO\n// Calcoliamo l'energia consumata nel periodo trascorso usando 'lastWatts'\n// Tetto di sicurezza a 12 ore per evitare sbalzi se il Cerbo è stato spento per giorni\nif (tDiffHours > 0 && tDiffHours < 12) {\n    let addedWh = lastWatts * tDiffHours;\n    dc_wh += addedWh;\n}\n\n// 2. SALVATAGGIO STATO GLOBALE\nglobal.set('dc_wh', dc_wh);\nglobal.set('log_dc_last_t', now);\nglobal.set('log_dc_last_watts', newWatts);\n\n// 3. STATUS VISIVO SU NODE-RED\nlet displayStr = (dc_wh >= 1000) ? (dc_wh / 1000).toFixed(2) + \" kWh\" : dc_wh.toFixed(0) + \" Wh\";\nnode.status({ fill: \"red\", shape: \"dot\", text: `${displayStr} (Ora: ${newWatts.toFixed(0)}W)` });\n\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 290,
        "y": 60,
        "wires": [
            []
        ]
    },
