        "func": "const toIta = (num, dec = 1) => {\n    let n = parseFloat(num);\n    if (isNaN(n)) return \"0\";\n    return n.toFixed(dec).replace('.', ',');\n};\n\nlet d = new Date();\nlet ts = d.getFullYear() + \"-\" + (\"0\"+(d.getMonth()+1)).slice(-2) + \"-\" + (\"0\"+d.getDate()).slice(-2) + \" \" + (\"0\"+d.getHours()).slice(-2) + \":\" + (\"0\"+d.getMinutes()).slice(-2);\n\nlet cSoc = global.get('batt_soc') || 0;\nlet cWind = global.get('wind_now') || 0;\nlet cTempQ = global.get('lastTempQ') || 0;\nlet cTempP = global.get('lastTemp') || 0;\nlet cHum = global.get('lastHum') || 0;\n\n// Risoluzione bug del Falso 0 per minimi e massimi giornalieri\nlet socMin = global.get('batt_soc_min_today');\nif (socMin === undefined || socMin === null) socMin = cSoc;\n\nlet socMax = global.get('batt_soc_max_today');\nif (socMax === undefined || socMax === null) socMax = cSoc;\n\nlet tqMin = global.get('temp_quadrato_min_today');\nif (tqMin === undefined || tqMin === null) tqMin = cTempQ;\n\nlet tqMax = global.get('temp_quadrato_max_today');\nif (tqMax === undefined || tqMax === null) tqMax = cTempQ;\n\nlet tpMin = global.get('temp_pozzetto_min_today');\nif (tpMin === undefined || tpMin === null) tpMin = cTempP;\n\nlet tpMax = global.get('temp_pozzetto_max_today');\nif (tpMax === undefined || tpMax === null) tpMax = cTempP;\n\nlet humMin = global.get('hum_pozzetto_min_today');\nif (humMin === undefined || humMin === null) humMin = cHum;\n\nlet humMax = global.get('hum_pozzetto_max_today');\nif (humMax === undefined || humMax === null) humMax = cHum;\n\nmsg.payload = [\n    ts, \n    toIta(global.get('log_lat') || 0, 6),\n    toIta(global.get('log_lon') || 0, 6),\n    toIta(socMin, 1) + \"%\",\n    toIta(socMax, 1) + \"%\",\n    toIta(tqMin, 1),\n    toIta(tqMax, 1),\n    toIta(tpMin, 1),\n    toIta(tpMax, 1),\n    toIta(humMin, 1) + \"%\",\n    toIta(humMax, 1) + \"%\",\n    toIta((global.get('log_y_prua') || 0) * 1000, 0),\n    toIta(global.get('log_p_prua') || 0, 0),\n    toIta((global.get('log_y_poppa') || 0) * 1000, 0),\n    toIta(global.get('log_p_poppa') || 0, 0),\n    toIta(global.get('dc_wh') || 0, 0),\n    toIta(global.get('wMin') || cWind, 1),\n    toIta(global.get('wMax') || cWind, 1)\n];\n\nreturn msg;",
