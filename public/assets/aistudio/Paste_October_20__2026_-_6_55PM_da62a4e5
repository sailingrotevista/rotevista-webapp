        "func": "// 1. Reset Energia DC e Tempo di Esecuzione (mantiene l'ultima potenza attiva per continuità)\nglobal.set('dc_wh', 0);\nglobal.set('log_dc_last_t', Date.now());\nif (global.get('log_dc_last_watts') === undefined) {\n    global.set('log_dc_last_watts', 0);\n}\n\n// 2. Reset Batteria (riparte dal valore attuale)\nlet currentSoc = global.get('batt_soc') || 0;\nglobal.set('batt_soc_min_today', currentSoc);\nglobal.set('batt_soc_max_today', currentSoc);\n\n// 3. Reset Temperature e Umidità Pozzetto (ripartono dai valori attuali)\nlet currentTemp = global.get('lastTemp');\nlet currentHum = global.get('lastHum');\nglobal.set('temp_pozzetto_min_today', currentTemp);\nglobal.set('temp_pozzetto_max_today', currentTemp);\nglobal.set('hum_pozzetto_min_today', currentHum);\nglobal.set('hum_pozzetto_max_today', currentHum);\n\n// 4. Reset Temperatura Quadrato\nlet currentTempQ = global.get('lastTempQ');\nglobal.set('temp_quadrato_min_today', currentTempQ);\nglobal.set('temp_quadrato_max_today', currentTempQ);\n\n// 5. Reset Vento (riparte dal valore attuale)\nlet lastW = global.get('wind_now') || 0;\nglobal.set('wMin', lastW);\nglobal.set('wMax', lastW);\n\nreturn null;",
